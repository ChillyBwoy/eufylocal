              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "description"
        ],
        "title": "HTTPError"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Measurement": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "measured_at": {
            "type": "string",
            "format": "date-time",
            "title": "Measured At"
          },
          "weight": {
            "type": "number",
            "title": "Weight"
          },
          "unit": {
            "$ref": "#/components/schemas/MeasurementUnit"
          },
          "impedance_ohm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Impedance Ohm"
          },
          "raw_data": {
            "type": "string",
            "title": "Raw Data"
          },
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/User"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "measured_at",
          "weight",
          "unit",
          "impedance_ohm",
          "raw_data",
          "user"
        ],
        "title": "Measurement"
      },
      "MeasurementUnit": {
        "type": "string",
        "enum": [
          "kg",
          "lb"
        ],
        "title": "MeasurementUnit"
      },
      "MeasurementUpdate": {
        "properties": {
          "user_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "MeasurementUpdate"
      },
      "User": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "color": {
            "type": "string",
            "title": "Color"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "color"
        ],
        "title": "User"
      },
      "UserCreate": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "color": {
            "type": "string",
            "minLength": 1,
            "title": "Color"
          }
        },
        "type": "object",
        "required": [
          "name",
          "color"
        ],
        "title": "UserCreate"
      },
      "UserUpdate": {
        "properties": {
          "name": {
            "anyOf": [
